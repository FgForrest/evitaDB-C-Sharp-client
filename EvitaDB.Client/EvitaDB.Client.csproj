<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Title>EvitaDB.Client</Title>
        <Authors>evitadb.io</Authors>
        <Description>evitaDB C# client allows connecting to a remote evitaDB server through gRPC API from .NET environment.</Description>
        <Copyright>2023, FGForrest a.s.</Copyright>
        <PackageProjectUrl>https://evitadb.io/</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/FgForrest/evitaDB-C-Sharp-client</RepositoryUrl>
        <PackageTags>database in-memory no-sql ecommerce</PackageTags>
        <PackageReleaseNotes>Typed entity contracts (annotated interfaces bound to entities, schema derivation, typed writes), referenceSummary and histogram requirements, culture-invariant formatting, and fixes to reference ordering, reference attribute fetching, facet impact and one-sided range serialization. See https://github.com/FgForrest/evitaDB-C-Sharp-client/releases for details.</PackageReleaseNotes>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!--
          Telemetry is on by default, so every existing consumer is unaffected. Building with
          `-p:EvitaTelemetry=false` drops the OpenTelemetry packages and compiles out OpenTelemetrySetup.
          That matters for Blazor WebAssembly, where the OTLP exporter and its protobuf stack are ~0.48 MB
          of Brotli-compressed payload shipped to a browser that has no collector to talk to.
        -->
        <EvitaTelemetry Condition="'$(EvitaTelemetry)' == ''">true</EvitaTelemetry>
        <DefineConstants Condition="'$(EvitaTelemetry)' == 'true'">$(DefineConstants);EVITA_TELEMETRY</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <None Include="$(OutputPath)$(AssemblyName).xml" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.35.1" />
        <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
        <PackageReference Include="Grpc.Tools" Version="2.83.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0"
                          Condition="'$(EvitaTelemetry)' == 'true'" />
        <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.17.0-beta.1" NoWarn="NU5104"
                          Condition="'$(EvitaTelemetry)' == 'true'" />
        <PackageReference Include="SauceControl.InheritDoc" Version="2.0.2">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- the setup class is the only file that touches OpenTelemetry types -->
    <ItemGroup Condition="'$(EvitaTelemetry)' != 'true'">
        <Compile Remove="Utils/OpenTelemetrySetup.cs" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf ProtoRoot="Protos" Include="Protos\*.proto" GrpcServices="Client"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath=""/>
        <None Include="..\README.md" Pack="true" PackagePath="">
            <Link>README.md</Link>
        </None>
    </ItemGroup>
</Project>
