<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!--
          Deliberately NOT trimmed: the driver pulls Newtonsoft.Json (reflection-heavy complex data object
          conversion) and the OpenTelemetry OTLP exporter. Trimming them safely is a rabbit hole with no payoff
          for a demo; the cost is a larger download.
        -->
        <PublishTrimmed>false</PublishTrimmed>
        <RunAOTCompilation>false</RunAOTCompilation>
        <!--
          The driver builds with TreatWarningsAsErrors; this demo does not, so that an unused-parameter warning
          in a .razor file never blocks running the sample.
        -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <!--
          Fingerprints the framework entry points too: publish rewrites the
          `blazor.webassembly#[.{fingerprint}].js` placeholder in index.html and fills the empty importmap
          with the fingerprinted dotnet.js et al. Without this, those two files keep STABLE names while the
          nginx config marks all of /_framework/ as immutable/1-year - so browsers and any caching proxy in
          front pin the old entry scripts (which reference the old fingerprinted assets) and keep booting the
          previous app version long after a redeploy. index.html itself is served no-store, so with every
          asset fingerprinted a redeploy is picked up immediately.
        -->
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
        <!-- gRPC-Web transport: the browser cannot speak plain gRPC over HTTP/2. -->
        <PackageReference Include="Grpc.Net.Client.Web" Version="2.83.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- local driver, not the NuGet package -->
        <ProjectReference Include="..\EvitaDB.Client\EvitaDB.Client.csproj" />
    </ItemGroup>

</Project>
