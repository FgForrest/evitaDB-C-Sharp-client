@inject StorefrontState State

@*
    One facet group: its heading and the option rows. Extracted from FacetPanel so the sidebar and the
    "all groups" modal render identical rows without duplicating the count/impact markup.

    Options are capped at `ValueLimit` in the sidebar, with a per-group "show all" toggle — a group like
    "CPU" can carry dozens of values, which would otherwise bury every other group.
*@
<div class="facet-group">
    @if (Group.GroupEntity is not null)
    {
        <h4>@Group.GroupEntity.DisplayName(State.Locale)</h4>
    }
    <ul>
        @foreach (FacetStatistics facet in Visible)
        {
            int? primaryKey = facet.FacetEntity.PrimaryKey;
            @if (primaryKey is not null)
            {
                @* @key is essential whenever rows can shift (an appended below-the-cut selection dropping out,
                   "show all" collapsing): without it Blazor reuses the <input> elements positionally and a
                   checkbox's user-clicked DOM state can end up on a different facet's row. *@
                <li @key="primaryKey.Value">
                    @* Checked state is read from StorefrontState (updated synchronously by the toggle), not from
                       facet.Requested (only refreshed by the next server response) - and bound via @bind:get/set
                       so Blazor patches its render tree with the click before diffing. A plain checked="..."
                       attribute is skipped as "unchanged" by the diff whenever the user's click already flipped
                       the DOM property, which is how checkboxes drifted out of sync until a full reload. *@
                    <label class="facet @(State.IsFacetSelected(Group.ReferenceName, primaryKey.Value) ? "selected" : null)">
                        <input type="checkbox"
                               @bind:get="State.IsFacetSelected(Group.ReferenceName, primaryKey.Value)"
                               @bind:set="_ => State.ToggleFacet(Group.ReferenceName, primaryKey.Value)"/>
                        <span class="facet-name">@facet.FacetEntity.DisplayName(State.Locale)</span>

                        @* how many products carry the option at all - independent of what is ticked *@
                        <span class="facet-count" title="@CountTooltip(facet)">@Number(facet.Count)</span>

                        @* what ticking it would do to the CURRENT result count. Hidden once applied:
                           evitaDB reports impact for adding an option, so for an applied one the figure
                           has no unambiguous reading. *@
                        @if (!facet.Requested && facet.Impact is { HasSense: true })
                        {
                            <span class="facet-impact @(facet.Impact.Difference >= 0 ? "widens" : "narrows")"
                                  title="@ImpactTooltip(facet)">
                                <span class="arrow">@(facet.Impact.Difference >= 0 ? "↑" : "↓")</span>@Number(facet.Impact.MatchCount)
                            </span>
                        }
                        else if (!facet.Requested)
                        {
                            <span class="facet-impact empty" title="Selecting this yields no products">
                                <span class="arrow">↓</span>0
                            </span>
                        }
                    </label>
                </li>
            }
        }
    </ul>

    @if (Hidden > 0)
    {
        <button class="link facet-more" @onclick="() => _expanded = !_expanded">
            @(_expanded ? "show fewer" : $"show all {Ordered.Count} options")
        </button>
    }
</div>

@code {

    [Parameter, EditorRequired] public FacetGroupStatistics Group { get; set; } = null!;

    /// <summary>Current result count, used to phrase the impact tooltip as "from X to Y".</summary>
    [Parameter] public int CurrentTotal { get; set; }

    /// <summary>Options shown before the per-group "show all" toggle appears.</summary>
    [Parameter] public int ValueLimit { get; set; } = 5;

    private bool _expanded;

    /// <summary>
    /// By option size only - deliberately NOT ticked-first: rows must stay where they are when the user ticks
    /// one, otherwise the option jumps away from under the cursor and cannot be unticked without chasing it.
    /// `Count` ignores the userFilter, so this order is stable across facet clicks.
    /// </summary>
    private List<FacetStatistics> Ordered =>
        Group.GetFacetStatistics()
            .OrderByDescending(facet => facet.Count)
            .ToList();

    /// <summary>
    /// First <see cref="ValueLimit"/> options in stable order; a selection sitting below the cut (possible via
    /// a shared URL, or ticked while expanded and then collapsed) is appended so an active filter is never
    /// invisible - appending keeps the visible rows in place, unlike re-sorting.
    /// </summary>
    private List<FacetStatistics> Visible =>
        _expanded || ValueLimit <= 0
            ? Ordered
            : Ordered.Take(ValueLimit)
                .Concat(Ordered.Skip(ValueLimit).Where(IsSelected))
                .ToList();

    private bool IsSelected(FacetStatistics facet) =>
        facet.FacetEntity.PrimaryKey is int primaryKey && State.IsFacetSelected(Group.ReferenceName, primaryKey);

    private int Hidden => Math.Max(0, Ordered.Count - Visible.Count);

    private string Number(int value) => value.ToString("N0", State.Locale);

    /// <summary>
    /// `Count` is how many entities carry the option, computed while ignoring the userFilter container - so it
    /// does not move as the shopper ticks things, which is what makes it a stable "size of this option".
    /// </summary>
    private string CountTooltip(FacetStatistics facet) =>
        $"{Number(facet.Count)} products have this option (regardless of what else is ticked)";

    /// <summary>
    /// `Impact.Difference` is the change to the *current* result count and `Impact.MatchCount` the resulting
    /// total - both differ from `Count` as soon as any other filter is active.
    /// </summary>
    private string ImpactTooltip(FacetStatistics facet)
    {
        RequestImpact impact = facet.Impact!;
        string direction = impact.Difference >= 0 ? "widens" : "narrows";
        string delta = $"{(impact.Difference >= 0 ? "+" : "−")}{Number(Math.Abs(impact.Difference))}";
        return $"Ticking this {direction} the results from {Number(CurrentTotal)} to "
               + $"{Number(impact.MatchCount)} ({delta})";
    }

}
