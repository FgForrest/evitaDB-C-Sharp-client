<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- source generators must target netstandard2.0: they are loaded by the compiler, not the app -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <Title>EvitaDB.Client.Generators</Title>
        <Authors>evitadb.io</Authors>
        <Description>
            Source generator emitting concrete implementations of annotated evitaDB typed entity
            contracts, so that contracts with default interface members work and no reflection is needed
            at run time.
        </Description>
        <Copyright>2023, FGForrest a.s.</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/FgForrest/evitaDB-C-Sharp-client</RepositoryUrl>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- ship the generator itself in the analyzer folder of the package -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

</Project>
